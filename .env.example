# Copy this file to .env and fill in your own values:  copy .env.example .env
# NEVER share your real .env or commit it to GitHub.

# (Optional) Groq API key from https://console.groq.com - free tier is enough.
# Leave it EMPTY to run fully offline with the keyword fallback classifier.
GROQ_API_KEY=

# Groq model to use when a key is set.
GROQ_MODEL=llama-3.1-8b-instant

# Admin key for the Authority Dashboard. DEMO ONLY default is admin123 -
# change this to your own word before any public demo.
ADMIN_KEY=admin123
